GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SERPAPI_KEY=
DEMO_MODE=0
PORT=3000
# Site URL or email, required by Nominatim's usage policy (sent in the User-Agent)
NOMINATIM_CONTACT=
# 0 turns the Amazon results off (a live search then spends half the SerpApi credits)
AMAZON_RESULTS=1

# Usage budgets (optional). Per client (IP) per day, and a shared SerpApi credit pool per day.
# Defaults: 20 searches, 150 chat turns, 40 idea requests per client; 400 SerpApi calls in total.
# BUDGET_SEARCHES_PER_DAY=20
# BUDGET_CHATS_PER_DAY=150
# BUDGET_IDEAS_PER_DAY=40
# BUDGET_MERCHANT_PER_DAY=40   # seller lookups (Buy / Open all), one credit each
# BUDGET_SERP_CREDITS_PER_DAY=400
# SEARCH_CACHE_HOURS=24
# SEARCH_PAGES=2   # pages fetched for the main query from each of Google Shopping and Amazon (1-3); each page is a SerpApi credit
