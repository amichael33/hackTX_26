# Settings for the Docker deployment. Copy to deploy/.env (which is never committed) and edit.

# The public address. A domain turns on automatic HTTPS. ":80" serves plain HTTP on any address.
# Geolocation and the microphone need HTTPS (or localhost), so use a real domain for the public demo.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# 1 = demo mode: built-in demo products and canned ideas, so the public site never spends SerpApi credits.
# Set to 0 (and fill in the keys) only if you really want live search on the public site.
DEMO_MODE=1

# Needed for the clerk's chat, stickers and ideas (Gemini). Leave empty to run with no Gemini calls at all.
GEMINI_API_KEY=
GEMINI_MODEL=
# Only used when DEMO_MODE=0. Every search costs credits (two, with Amazon on).
SERPAPI_KEY=
AMAZON_RESULTS=1
# A site URL or email: Nominatim's usage policy asks for one in the User-Agent of geocoding requests.
NOMINATIM_CONTACT=

# Usage budgets (only matter in live mode). Counted in memory per visitor and for everyone; a restart resets them.
# Past a limit the site serves demo stock and the clerk says the back room is closed.
# BUDGET_SEARCHES_PER_DAY=20
# BUDGET_CHATS_PER_DAY=150
# BUDGET_IDEAS_PER_DAY=40
# BUDGET_SERP_CREDITS_PER_DAY=400   # shared by everyone: set it to fit your SerpApi plan
